# 1. LLM Brain (Choose Gemini or OpenAI)
# Recommended: Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
DEFAULT_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash

# Optional: OpenAI Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 2. Meta Marketing API (To auto-pause/scale live Facebook & Instagram ads)
# Get token at https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_APP_ID=
META_APP_SECRET=

# 3. Notification Webhooks (Optional for instant WhatsApp/Telegram alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_WEBHOOK_URL=

# 4. Senior Media Buyer Safeguards & Thresholds
TARGET_CPA=250.0
MAX_CPC=15.0
BLEEDER_SPEND_MULTIPLIER=2.5
FATIGUE_FREQUENCY=3.2
WINNER_ROAS=3.0
MAX_DAILY_BUDGET_CAP=5000.0
